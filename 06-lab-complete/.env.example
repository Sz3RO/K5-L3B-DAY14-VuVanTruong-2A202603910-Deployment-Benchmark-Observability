# Copy: cp .env.example .env   (.env đã nằm trong .gitignore — KHÔNG commit secret thật)
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret: đặt giá trị ngẫu nhiên, vd `python -c "import secrets; print(secrets.token_urlsafe(32))"`
AGENT_API_KEY=

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
